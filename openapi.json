      "post": {
        "summary": "Upload Match Score & Individual Player Stats",
        "tags": ["Matches"],
        "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "matchId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["homeTeamGoals", "awayTeamGoals", "playerStats"],
                "properties": {
                  "homeTeamGoals": { "type": "integer" },
                  "awayTeamGoals": { "type": "integer" },
                  "playerStats": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["userId"],
                      "properties": {
                        "userId": { "type": "string", "format": "uuid" },
                        "goals": { "type": "integer" },
                        "assists": { "type": "integer" },
                        "cleanSheets": { "type": "integer" },
                        "yellowCards": { "type": "integer" },
                        "redCards": { "type": "integer" },
                        "rating": { "type": "number", "format": "float" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Result uploaded; match status transitions to RESULT_UPLOADED" },
          "403": { "description": "Only match captains or admins can upload results" }
        }
      }
